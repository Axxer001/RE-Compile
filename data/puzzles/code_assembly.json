 "ring_of_fire": {
  "topic": "C++ Syntax: statements end with ;, code lives in { } blocks, using namespace std",
  "variants": [
   {
    "lines": [
     "#include <iostream>",
     "using namespace std;",
     "int main() {",
     "  cout << \"Ring of Fire: six orbs circle you.\";",
     "  cout << \"They burn whatever they touch.\";",
     "  return 0;",
     "}"
    ],
    "swap": []
   },
   {
    "lines": [
     "#include <iostream>",
     "int main() {",
     "  std::cout << \"No using line: std:: names the library.\";",
     "  return 0;",
     "}"
    ],
    "swap": []
   },
   {
    "lines": [
     "#include <iostream>",
     "using namespace std;",
     "int main() {",
     "  {",
     "    cout << \"An inner block.\";",
     "  }",
     "  return 0;",
     "}"
    ],
    "swap": []
   },
   {
